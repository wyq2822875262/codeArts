# 监听
HOST=127.0.0.1
PORT=7864

# 数据目录（SQLite 落在这里，记得备份）
DATA_DIR=./data

# 管理员密码：公网部署前必须改掉
ADMIN_PASSWORD=change-me-please

# 会话签名密钥，留空则每次启动随机生成（重启后管理面要重新登录）
# 生成：openssl rand -hex 32
SESSION_SECRET=

# 上游，一般不用改
UPSTREAM_BASE=https://devcloud.cn-north-4.huaweicloud.com/chat

# 单次上游请求超时（毫秒）
REQUEST_TIMEOUT_MS=300000

# 上游并发上限
MAX_CONCURRENCY=8

# 反向代理：前面挂了 Nginx / Caddy 就设 true，才会采信 X-Forwarded-For
TRUST_PROXY=true

# 只信任这些来源的转发头（逗号分隔，精确 IP 或网段前缀）；留空表示信任任意对端。
# 因为 HOST 默认 127.0.0.1，外部本来就进不来，留空是安全的。
TRUSTED_PROXIES=127.0.0.1
